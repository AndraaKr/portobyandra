# ============================================
# SUPABASE (WAJIB DIISI)
# Ambil dari Supabase Dashboard > Settings > API
# ============================================

# Project URL — bentuknya https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"

# Publishable key (dulu disebut "anon key") — AMAN dipakai di frontend
# JANGAN pernah isi ini dengan "Secret key" (dulu disebut "service_role")
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"


# ============================================
# Sisa dari template AI Studio — tidak dipakai lagi setelah migrasi ke Supabase.
# Boleh dihapus, dibiarkan juga tidak masalah.
# ============================================
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
